# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/

# Environment Variables / secrets (bot token, user id) — keep only the example
.env
.env.*
!.env.example

# Credentials & keys (Google API service accounts, OAuth clients, certificates)
*.pem
*.key
*.p12
*.pfx
credentials*.json
client_secret*.json
service_account*.json
token*.json

# Browser sessions: Chrome profile holds the logged-in Google cookies — NEVER commit
chrome-profile/
**/chrome-profile/
cookies*.json
storage_state*.json
auth_state*.json

# Workspace directory (chrome profile, sessions, outputs, saved models, debug dumps, logs)
workspace/

# Logs & State
*.log
*.pickle
*.sqlite
*.db

# IDE / Editor / local tool settings
.vscode/
.idea/
*.swp
.claude/settings.local.json

# OS files
Thumbs.db
desktop.ini
.DS_Store
